<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meal Prep Service</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-black text-white d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg app-navbar mb-3">
            <div class="container-fluid app-navbar-inner">
                <a class="navbar-brand app-brand" asp-page="/Index">
                    <span class="app-brand-icon"><i class="bi bi-basket2-fill"></i></span>
                    <span>
                        <strong>Meal Prep Service</strong>
                        <small>Smart meal planning and delivery</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse app-navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav app-main-nav">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-page="/PublicMenu/Today">
                                <i class="bi bi-calendar-day"></i> Today's Menu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-page="/PublicMenu/Weekly">
                                <i class="bi bi-calendar-week"></i> Weekly Menu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-nav-link" asp-page="/AITest/MealNutritionAnalyzer">
                                <i class="bi bi-calculator"></i> Nutrition Analyzer
                            </a>
                        </li>

                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" asp-page="/Order/StaffReview">
                                    <i class="bi bi-receipt-cutoff"></i> Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" asp-page="/Delivery/Management">
                                    <i class="bi bi-truck"></i> Delivery
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("DeliveryMan"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link" asp-page="/Delivery/AssignedDeliveries">
                                    <i class="bi bi-truck"></i> Deliveries
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <div class="app-navbar-actions">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto"
            style="background-color:#22B14C; color:white;">
        <div class="container py-2">
            <div class="row">
                <div class="col-md-6">
                    © 2026 - Meal Prep Service
                </div>
                <div class="col-md-6 text-end">
                    <a asp-page="/Privacy"
                       class="text-white text-decoration-none">
                        Privacy Policy
                    </a>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/signalr-connection.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
