<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Meal Prep Service</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Navigation menu spacing and hover effects */
        .navbar-nav .nav-item {
            margin-right: 1rem;
        }
        
        .navbar-nav .nav-link {
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            transition: all 0.3s ease;
            position: relative;
        }
        
        .navbar-nav .nav-link:hover {
            background-color: #f8f9fa;
            color: #0d6efd !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        
        .navbar-nav .nav-link i {
            transition: transform 0.3s ease;
        }
        
        .navbar-nav .nav-link:hover i {
            transform: scale(1.2);
        }
        
        /* Dropdown hover effect */
        .navbar-nav .dropdown-toggle:hover {
            background-color: #f8f9fa;
            color: #0d6efd !important;
        }
        
        .dropdown-item:hover {
            background-color: #0d6efd;
            color: white !important;
        }
        
        .dropdown-item:hover i {
            transform: scale(1.1);
        }
    </style>
</head>
<body class="bg-black text-white d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <strong>Meal Prep Service</strong>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/PublicMenu/Today">
                                <i class="bi bi-calendar-day"></i> Today's Menu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/PublicMenu/Weekly">
                                <i class="bi bi-calendar-week"></i> Weekly Menu
                            </a>
                        </li>
                        
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/HealthProfile/Index">
                                    <i class="bi bi-heart-pulse"></i> Health Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/MealPlan/Index">
                                    <i class="bi bi-clipboard-check"></i> My Meal Plans
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Fridge/Index">
                                    <i class="bi bi-box-seam"></i> My Fridge
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Menu/Index">
                                    <i class="bi bi-calendar3"></i> Menus
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Recipe/Index">
                                    <i class="bi bi-book"></i> Recipes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Ingredient/Index">
                                    <i class="bi bi-egg"></i> Ingredients
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Allergy/Index">
                                    <i class="bi bi-exclamation-triangle"></i> Allergies
                                </a>
                            </li>
                        }
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    System Management
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-page="/Admin/Dashboard">
                                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/StaffAccounts">
                                        <i class="fas fa-users-cog me-2"></i>Staff Accounts
                                    </a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Revenue">
                                        <i class="bi bi-graph-up me-2"></i>Revenue Reports
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/SystemConfiguration">
                                        <i class="bi bi-gear me-2"></i>System Configuration
                                    </a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Menu/Index">
                                        <i class="bi bi-calendar-week me-2"></i>Manage Menus
                                    </a></li>
                                    <li><a class="dropdown-item" asp-page="/Recipe/Index">
                                        <i class="bi bi-book me-2"></i>Manage Recipes
                                    </a></li>
                                    <li><a class="dropdown-item" asp-page="/Ingredient/Index">
                                        <i class="bi bi-egg me-2"></i>Manage Ingredients
                                    </a></li>
                                    <li><a class="dropdown-item" asp-page="/Allergy/Index">
                                        <i class="bi bi-exclamation-triangle me-2"></i>Manage Allergies
                                    </a></li>
                                </ul>
                            </li>
                        }
                        
                        @if (User.IsInRole("DeliveryMan"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Delivery/AssignedDeliveries">My Deliveries</a>
                            </li>
                        }
                    </ul>
                    
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto"
            style="background-color:#22B14C; color:white;">
        <div class="container py-2">
            <div class="row">
                <div class="col-md-6">
                    © 2026 - Meal Prep Service
                </div>
                <div class="col-md-6 text-end">
                    <a asp-page="/Privacy"
                       class="text-white text-decoration-none">
                        Privacy Policy
                    </a>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/signalr-connection.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
