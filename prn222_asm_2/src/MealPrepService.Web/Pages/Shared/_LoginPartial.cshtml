@using System.Security.Claims

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item dropdown">
            <a class="nav-link app-nav-link dropdown-toggle" href="#" id="userDropdown" role="button" 
               data-bs-toggle="dropdown" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                </svg>
                <span class="user-name-text">@User.FindFirst(ClaimTypes.Name)?.Value</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                <li>
                    <h6 class="dropdown-header">
                        @User.FindFirst(ClaimTypes.Email)?.Value
                    </h6>
                </li>
                @if (User.IsInRole("Customer"))
                {
                    <li><a class="dropdown-item" asp-page="/Order/MyCart"><i class="bi bi-bag me-2"></i>Cart</a></li>
                    <li><a class="dropdown-item" asp-page="/Order/Index"><i class="bi bi-receipt me-2"></i>Order</a></li>
                    <li><a class="dropdown-item" asp-page="/HealthProfile/Index"><i class="bi bi-heart-pulse me-2"></i>Health Profile</a></li>
                    <li><a class="dropdown-item" asp-page="/MealPlan/Index"><i class="bi bi-clipboard-check me-2"></i>Meal Plan</a></li>
                    <li><a class="dropdown-item" asp-page="/Fridge/Index"><i class="bi bi-box-seam me-2"></i>Fridge</a></li>
                }
                @if (User.IsInRole("Manager"))
                {
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Manager Tools</h6></li>
                    <li><a class="dropdown-item" asp-page="/Menu/Index"><i class="bi bi-calendar3 me-2"></i>Menus</a></li>
                    <li><a class="dropdown-item" asp-page="/Recipe/Index"><i class="bi bi-book me-2"></i>Recipes</a></li>
                    <li><a class="dropdown-item" asp-page="/Ingredient/Index"><i class="bi bi-egg me-2"></i>Ingredients</a></li>
                    <li><a class="dropdown-item" asp-page="/Allergy/Index"><i class="bi bi-exclamation-triangle me-2"></i>Allergies</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Admin Tools</h6></li>
                    <li><a class="dropdown-item" asp-page="/Admin/Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Admin/StaffAccounts">
                        <i class="bi bi-person-lines-fill me-2"></i>Staff Accounts
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Admin/Revenue">
                        <i class="bi bi-graph-up me-2"></i>Revenue Reports
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Admin/SystemConfiguration">
                        <i class="bi bi-gear me-2"></i>System Configuration
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Menu/Index">
                        <i class="bi bi-calendar-week me-2"></i>Manage Menus
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Recipe/Index">
                        <i class="bi bi-book me-2"></i>Manage Recipes
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Ingredient/Index">
                        <i class="bi bi-egg me-2"></i>Manage Ingredients
                    </a></li>
                    <li><a class="dropdown-item" asp-page="/Allergy/Index">
                        <i class="bi bi-exclamation-triangle me-2"></i>Manage Allergies
                    </a></li>
                }
                <li><hr class="dropdown-divider"></li>
                
                <li>
                    <form asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-box-arrow-right me-2" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>
                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z"/>
                            </svg>
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link app-nav-link" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link app-nav-link" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
