@page
@model MealPrepService.Web.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Accounts Management";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="fas fa-users-cog"></i> Accounts Management</h2>
            <p class="text-muted">Manage Admin, Staff, Manager, Delivery Man, and Customer accounts</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-page="CreateAccount"
               class="btn text-white"
               style="background-color:#22B14C; border-color:#22B14C;">
                <i class="fas fa-plus"></i> Create New Account
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-6 g-3 mb-4">
        <div class="col-md-4 col-lg-2">
            <div class="card text-center h-100 account-summary-card">
                <div class="card-body">
                    <h5 class="card-title">Total</h5>
                    <h2 class="text-primary">@Model.TotalAccounts</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="card text-center h-100 account-summary-card">
                <div class="card-body">
                    <h5 class="card-title">Admins</h5>
                    <h2 class="text-danger">@Model.TotalAdmins</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="card text-center h-100 account-summary-card">
                <div class="card-body">
                    <h5 class="card-title">Managers</h5>
                    <h2 class="text-info">@Model.TotalManagers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-lg-2">
            <div class="card text-center h-100 account-summary-card">
                <div class="card-body">
                    <h5 class="card-title">Staff</h5>
                    <h2 class="text-secondary">@Model.TotalStaff</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-lg-3">
            <div class="card text-center h-100 account-summary-card">
                <div class="card-body">
                    <h5 class="card-title">Delivery Men</h5>
                    <h2 class="text-success">@Model.TotalDeliveryMen</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-lg-3">
            <div class="card text-center h-100 account-summary-card">
                <div class="card-body">
                    <h5 class="card-title">Customers</h5>
                    <h2 class="text-warning">@Model.TotalCustomers</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4" style="background-color: #0F172A; border-color: rgba(34,197,94,.25);">
        <div class="card-body">
            <form method="get" asp-page="Accounts" class="row g-3">
                <div class="col-md-6 col-xl-5">
                    <label for="role" class="form-label text-white">Filter by Role</label>
                    <select name="role" id="role" class="form-select no-select2" onchange="this.form.submit()" data-no-select2="true" style="background-color: #020617; border-color: rgba(34,197,94,.35); color: #fff;">
                        <option value="">All Accounts</option>
                        <option value="Admin" selected="@(Model.FilterRole == "Admin")">Admins</option>
                        <option value="Staff" selected="@(Model.FilterRole == "Staff")">Staff</option>
                        <option value="Manager" selected="@(Model.FilterRole == "Manager")">Managers</option>
                        <option value="DeliveryMan" selected="@(Model.FilterRole == "DeliveryMan")">Delivery Men</option>
                        <option value="Customer" selected="@(Model.FilterRole == "Customer")">Customers</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

    <div class="card" style="background-color: #0F172A; border-color: rgba(34,197,94,.25);">
        <div class="card-header text-white" style="background-color: #1e293b;">
            <h5 class="mb-0">
                @if (!string.IsNullOrEmpty(Model.FilterRole))
                {
                    <span>@Model.FilterRole Accounts</span>
                }
                else
                {
                    <span>All Accounts</span>
                }
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Accounts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="text-white" style="background-color: transparent;">Full Name</th>
                                <th class="text-white" style="background-color: transparent;">Email</th>
                                <th class="text-white" style="background-color: transparent;">Role</th>
                                <th class="text-end text-white" style="background-color: transparent;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model.Accounts)
                            {
                                <tr>
                                    <td class="text-white" style="background-color: transparent;">
                                        <strong>@account.FullName</strong>
                                    </td>
                                    <td class="text-white" style="background-color: transparent;">@account.Email</td>
                                    <td style="background-color: transparent;">
                                        <span class="@account.RoleBadgeClass">@account.Role</span>
                                    </td>
                                    <td class="text-end" style="background-color: transparent;">
                                        <a asp-page="EditAccount" asp-route-id="@account.Id"
                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a asp-page="DeleteAccount" asp-route-id="@account.Id"
                                           class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No accounts found.
                    <a asp-page="CreateAccount" class="alert-link">Create one now</a>.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .account-summary-card {
        background-color: #0f1b46;
        border: 1px solid rgba(34, 177, 76, 0.3);
    }

    .account-summary-card .card-title {
        color: #ffffff;
    }
</style>