@page
@model MealPrepService.Web.Pages.Admin.RevenueManagementModel
@{
    ViewData["Title"] = "Revenue Management - View & Delete Reports";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear"></i> Revenue Report Management</h2>
        <div>
            <a asp-page="Revenue" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Back to Revenue Reports
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Total Reports</h6>
                    <h3 class="text-primary mb-0">@Model.TotalReports</h3>
                    <small class="text-muted">in database</small>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Total Revenue</h6>
                    <h3 class="text-success mb-0">@Model.TotalRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Total Orders</h6>
                    <h3 class="text-info mb-0">@Model.TotalOrders</h3>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.AllReports.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3">No Revenue Reports</h4>
                <p class="text-muted">No revenue reports have been generated yet.</p>
            </div>
        </div>
    }
    else
    {
        var groupedByMonthYear = Model.AllReports.GroupBy(r => new { r.Year, r.Month });
        var duplicateCount = groupedByMonthYear.Where(g => g.Count() > 1).Sum(g => g.Count() - 1);

        @if (duplicateCount > 0)
        {
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle"></i> 
                <strong>Found @duplicateCount duplicate report(s)!</strong> 
                Some months have multiple reports. You can delete duplicates using the "Delete Duplicates" button below.
            </div>
        }

        <!-- All Reports Table -->
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-table"></i> All Revenue Reports (@Model.AllReports.Count())</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-light">
                            <tr>
                                <th class="text-white" style="background-color: transparent;">Period</th>
                                <th class="text-end text-white" style="background-color: transparent;">Order Revenue</th>
                                <th class="text-end text-white" style="background-color: transparent;">Subscription Revenue</th>
                                <th class="text-end text-white" style="background-color: transparent;">Total Revenue</th>
                                <th class="text-end text-white" style="background-color: transparent;">Orders</th>
                                <th class="text-end text-white" style="background-color: transparent;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.AllReports)
                            {
                                var isDuplicate = groupedByMonthYear
                                    .FirstOrDefault(g => g.Key.Year == report.Year && g.Key.Month == report.Month)?
                                    .Count() > 1;

                                <tr style="@(isDuplicate ? "background-color: #fff3cd;" : "")">
                                    <td class="text-white" style="background-color: transparent;">
                                        <strong>@report.MonthName @report.Year</strong>
                                        @if (isDuplicate)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">DUPLICATE</span>
                                        }
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        @report.TotalOrderRevenue.ToString("C")
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        @report.TotalSubscriptionRevenue.ToString("C")
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        <strong class="text-primary">@report.TotalRevenue.ToString("C")</strong>
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        @report.TotalOrdersCount
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        <form method="post" asp-page-handler="Delete" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reportId" value="@report.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this report?');">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Delete Duplicates Section -->
        @if (duplicateCount > 0)
        {
            <div class="card mt-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-exclamation-circle"></i> Months with Duplicates</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Month/Year</th>
                                    <th class="text-center">Count</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in groupedByMonthYear.Where(g => g.Count() > 1).OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Month))
                                {
                                    var monthYearDate = new DateTime(group.Key.Year, group.Key.Month, 1);
                                    <tr>
                                        <td>
                                            <strong>@monthYearDate.ToString("MMMM yyyy")</strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-danger">@group.Count() reports</span>
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DeleteDuplicates" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="year" value="@group.Key.Year" />
                                                <input type="hidden" name="month" value="@group.Key.Month" />
                                                <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('This will keep the latest report and delete @(group.Count() - 1) duplicate(s). Continue?');">
                                                    <i class="bi bi-trash"></i> Delete Duplicates
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .card {
        background-color: #0F172A;
        border-color: rgba(34, 197, 94, .25);
    }

    .card-header {
        border-color: rgba(34, 197, 94, .25);
    }

    .table tbody tr:hover {
        background-color: rgba(34, 197, 94, .1) !important;
    }

    .alert {
        background-color: #0F172A;
        border-color: rgba(34, 197, 94, .25);
        color: #fff;
    }

    .text-white {
        color: #fff !important;
    }

    .text-muted {
        color: #999 !important;
    }
</style>
