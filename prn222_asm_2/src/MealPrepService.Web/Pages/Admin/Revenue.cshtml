@page
@model MealPrepService.Web.Pages.Admin.RevenueModel
@{
    ViewData["Title"] = "Revenue Reports";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up"></i> Revenue Reports</h2>
        <div>
            <a asp-page="Dashboard"
               class="btn"
               style="background:#6c757d; color:#fff; border:none;"
               onmouseover="this.style.background='#adb5bd'; this.style.color='#000';"
               onmouseout="this.style.background='#6c757d'; this.style.color='#fff';">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Year Selection -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-page="Revenue" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="year" class="form-label">Select Year</label>
                    <select class="form-select" id="year" name="year" onchange="this.form.submit()" data-placeholder="Select a year...">
                        @foreach (var year in Model.AvailableYears)
                        {
                            if (year == Model.SelectedYear)
                            {
                                <option value="@year" selected>@year</option>
                            }
                            else
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-8">
                    <form asp-page="GenerateMonthlyReport" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="year" value="@Model.SelectedYear" />
                        <input type="hidden" name="month" value="@DateTime.Now.Month" />
                        <button type="submit"
                                class="btn"
                                style="background-color:#22B14C; border-color:#22B14C; color:#fff;">
                            <i class="bi bi-file-earmark-plus"></i> Generate Current Month Report
                        </button>
                    </form>
                </div>
            </form>
        </div>
    </div>

    <!-- Yearly Summary -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-calendar-check"></i> @Model.YearlySummary.Year Summary</h4>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-stretch">
                <div class="col-md-3 d-flex">
                    <div class="summary-card text-center p-3 rounded w-100">
                        <h6 class="summary-card-title mb-2">Total Revenue</h6>
                        <h3 class="text-success mb-0">@Model.YearlySummary.TotalRevenue.ToString("C")</h3>
                        <small class="summary-card-meta">&nbsp;</small>
                    </div>
                </div>
                <div class="col-md-3 d-flex">
                    <div class="summary-card text-center p-3 rounded w-100">
                        <h6 class="summary-card-title mb-2">Order Revenue</h6>
                        <h3 class="text-success mb-0">@Model.YearlySummary.TotalOrderRevenue.ToString("C")</h3>
                        <small class="summary-card-meta">@Model.YearlySummary.TotalOrders orders</small>
                    </div>
                </div>
                <div class="col-md-3 d-flex">
                    <div class="summary-card text-center p-3 rounded w-100">
                        <h6 class="summary-card-title mb-2">Subscription Revenue</h6>
                        <h3 class="text-info mb-0">@Model.YearlySummary.TotalSubscriptionRevenue.ToString("C")</h3>
                        <small class="summary-card-meta"></small>
                    </div>
                </div>
                <div class="col-md-3 d-flex">
                    <div class="summary-card text-center p-3 rounded w-100">
                        <h6 class="summary-card-title mb-2">Avg Monthly Revenue</h6>
                        <h3 class="text-white mb-0">@Model.YearlySummary.AverageMonthlyRevenue.ToString("C")</h3>
                        <small class="summary-card-meta">&nbsp;</small>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.YearlySummary.BestMonth))
            {
                <div class="alert alert-success mt-3 mb-0">
                    <i class="bi bi-trophy-fill"></i> 
                    <strong>Best Performing Month:</strong> @Model.YearlySummary.BestMonth with 
                    <strong>@Model.YearlySummary.BestMonthRevenue.ToString("C")</strong> in revenue
                </div>
            }
        </div>
    </div>

    <!-- Monthly Reports Table -->
    @if (Model.HasReports)
    {
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-table"></i> Monthly Breakdown</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover revenue-breakdown-table mb-0">
                        <colgroup>
                            <col class="col-month" />
                            <col class="col-currency" />
                            <col class="col-currency" />
                            <col class="col-currency" />
                            <col class="col-orders" />
                            <col class="col-currency" />
                        </colgroup>
                        <thead class="table-light">
                            <tr>
                                <th class="text-white col-month" style="background-color: transparent;">Month</th>
                                <th class="text-white col-currency" style="background-color: transparent;">Order Revenue</th>
                                <th class="text-white col-currency" style="background-color: transparent;">Subscription Revenue</th>
                                <th class="text-white col-currency" style="background-color: transparent;">Total Revenue</th>
                                <th class="text-center text-white col-orders" style="background-color: transparent;">Orders</th>
                                <th class="text-white col-currency" style="background-color: transparent;">Avg Order Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.MonthlyReports)
                            {
                                <tr>
                                    <td class="text-white col-month" style="background-color: transparent;"><strong>@report.MonthName</strong></td>
                                    <td class="text-white col-currency" style="background-color: transparent;">
                                        @if (report.HasOrderRevenue)
                                        {
                                            <span class="text-success">@report.TotalOrderRevenue.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">$0.00</span>
                                        }
                                    </td>
                                    <td class="text-white col-currency" style="background-color: transparent;">
                                        @if (report.HasSubscriptionRevenue)
                                        {
                                            <span class="text-info">@report.TotalSubscriptionRevenue.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">$0.00</span>
                                        }
                                    </td>
                                    <td class="text-white col-currency" style="background-color: transparent;">
                                        <strong class="text-primary">@report.TotalRevenue.ToString("C")</strong>
                                    </td>
                                    <td class="text-center text-white col-orders" style="background-color: transparent;">
                                        @if (report.HasOrders)
                                        {
                                            <span>@report.TotalOrdersCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-white col-currency" style="background-color: transparent;">
                                        @if (report.HasOrders)
                                        {
                                            <span>@report.AverageOrderValue.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="revenue-total-row">
                                <td class="text-white text-success col-month" style="background-color: transparent;"><strong>Total</strong></td>
                                <td class="text-success col-currency" style="background-color: transparent;"><strong>@Model.YearlySummary.TotalOrderRevenue.ToString("C")</strong></td>
                                <td class="text-info col-currency" style="background-color: transparent;"><strong>@Model.YearlySummary.TotalSubscriptionRevenue.ToString("C")</strong></td>
                                <td class="text-primary col-currency" style="background-color: transparent;"><strong>@Model.YearlySummary.TotalRevenue.ToString("C")</strong></td>
                                <td class="text-center text-white col-orders" style="background-color: transparent;"><strong>@Model.YearlySummary.TotalOrders</strong></td>
                                <td class="text-white col-currency" style="background-color: transparent;"><strong>-</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Revenue Chart (Placeholder for future implementation) -->
        <div class="card mt-4">
            <div class="card-header bg-light" style="background-color: #1e293b !important;">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Revenue Trends</h5>
            </div>
            <div class="card-body">
                <div class="text-center py-5">
                    <i class="bi bi-bar-chart" style="font-size: 4rem; color: #ccc;"></i>
                    <h5 class="mt-3 text-muted">Chart Visualization</h5>
                    <p class="text-muted">Revenue trend chart will be displayed here</p>
                    <small class="text-muted">
                        Chart data available: @Model.ChartData.Count months
                    </small>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-graph-up" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3">No Revenue Reports Available</h4>
                <p class="text-muted">No reports have been generated for @Model.SelectedYear yet.</p>
                <form asp-page="GenerateMonthlyReport" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="year" value="@Model.SelectedYear" />
                    <input type="hidden" name="month" value="@DateTime.Now.Month" />
                    <button type="submit" class="btn btn-primary mt-2">
                        <i class="bi bi-file-earmark-plus"></i> Generate Current Month Report
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Note about deferred features -->
    <div class="alert alert-info mt-4">
        <i class="bi bi-info-circle"></i> 
        <strong>Note:</strong> Subscription revenue calculations are deferred to Checkpoint 2. 
        Current reports show order revenue only.
    </div>
</div>

<style>
    .table tbody tr {
        transition: background-color 0.2s;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .revenue-breakdown-table .revenue-total-row td {
        background: rgba(34, 177, 76, 0.16) !important;
        border-top: 2px solid rgba(34, 177, 76, 0.55);
        font-weight: 700;
    }

    .revenue-breakdown-table .revenue-total-row td strong {
        letter-spacing: 0.2px;
    }

    .revenue-breakdown-table {
        table-layout: fixed;
    }

    .revenue-breakdown-table .col-month {
        width: 140px;
        text-align: center;
    }

    .revenue-breakdown-table .col-orders {
        width: 110px;
        text-align: center;
    }

    .revenue-breakdown-table .col-currency {
        width: 200px;
        text-align: center;
    }

    .revenue-breakdown-table th,
    .revenue-breakdown-table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    @@media (max-width: 1200px) {
        .revenue-breakdown-table {
            table-layout: auto;
        }

        .revenue-breakdown-table th,
        .revenue-breakdown-table td {
            white-space: normal;
        }
    }
    
    .summary-card {
        background-color: #1e293b;
        min-height: 132px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .summary-card-title {
        color: #cbd5e1;
        font-weight: 600;
    }

    .summary-card-meta {
        color: #94a3b8;
        min-height: 1.2rem;
        margin-top: 0.5rem;
        display: block;
    }

    .summary-card h3 {
        line-height: 1.2;
    }

    .summary-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
</style>
