@page
@model MealPrepService.Web.Pages.Admin.RevenueModel
@{
    ViewData["Title"] = "Revenue Reports";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up"></i> Revenue Reports</h2>
        <div>
            <a asp-page="Revenue"
               class="btn"
               style="background:#6c757d; color:#fff; border:none;"
               onmouseover="this.style.background='#adb5bd'; this.style.color='#000';"
               onmouseout="this.style.background='#6c757d'; this.style.color='#fff';">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Generate Report Section -->
    <div class="card mb-4" style="background-color: #0F172A; border-color: rgba(34,197,94,.25);">
        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Generate New Report</h5>
                <a asp-page="RevenueManagement" class="btn btn-sm btn-warning" title="View all reports and delete duplicates">
                    <i class="bi bi-gear"></i> Manage All Reports
                </a>
            </div>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Generate" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label for="year" class="form-label text-white">Select Year</label>
                    <select class="form-select" id="year" name="year" style="background-color: #020617; border-color: rgba(34,197,94,.35); color: #fff;">
                        @foreach (var year in Model.AvailableYears)
                        {
                            if (year == Model.SelectedYear)
                            {
                                <option value="@year" selected>@year</option>
                            }
                            else
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="month" class="form-label text-white">Select Month</label>
                    <select class="form-select" id="month" name="month" style="background-color: #020617; border-color: rgba(34,197,94,.35); color: #fff;">
                        @for (int m = 1; m <= 12; m++)
                        {
                            var monthName = new DateTime(2024, m, 1).ToString("MMMM");
                            if (m == Model.SelectedMonth)
                            {
                                <option value="@m" selected>@monthName</option>
                            }
                            else
                            {
                                <option value="@m">@monthName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn w-100" style="background-color:#22B14C; border-color:#22B14C; color:#fff; height: 38px;">
                        <i class="bi bi-file-earmark-plus"></i> Generate & Save Report
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Yearly Summary -->
    <div class="card mb-4 border-primary">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-calendar-check"></i> @Model.YearlySummary.Year Summary</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3 bg-light rounded" style="background-color: #1e293b !important;">
                        <h6 class="text-muted mb-2">Total Revenue</h6>
                        <h3 class="text-primary mb-0">@Model.YearlySummary.TotalRevenue.ToString("C")</h3>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3 bg-light rounded" style="background-color: #1e293b !important;">
                        <h6 class="text-muted mb-2">Order Revenue</h6>
                        <h3 class="text-success mb-0">@Model.YearlySummary.TotalOrderRevenue.ToString("C")</h3>
                        <small class="text-muted">@Model.YearlySummary.TotalOrders orders</small>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3 bg-light rounded" style="background-color: #1e293b !important;">
                        <h6 class="text-muted mb-2">Subscription Revenue</h6>
                        <h3 class="text-info mb-0">@Model.YearlySummary.TotalSubscriptionRevenue.ToString("C")</h3>
                        <small class="text-muted">Deferred to Checkpoint 2</small>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="text-center p-3 bg-light rounded" style="background-color: #1e293b !important;">
                        <h6 class="text-muted mb-2">Avg Monthly Revenue</h6>
                        <h3 class="text-secondary mb-0">@Model.YearlySummary.AverageMonthlyRevenue.ToString("C")</h3>
                    </div>
                </div>
            </div>

                @if (!string.IsNullOrEmpty(Model.YearlySummary.BestMonth))
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <i class="bi bi-trophy-fill"></i> 
                        <strong>Best Performing Month:</strong> @Model.YearlySummary.BestMonth with 
                        <strong>@Model.YearlySummary.BestMonthRevenue.ToString("C")</strong> in revenue
                    </div>
                }
            </div>
        </div>
    }

    <!-- Reports Table -->
    @if (Model.FilteredReports.Any())
    {
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-table"></i> Saved Reports (@Model.FilteredReports.Count())</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover revenue-breakdown-table mb-0">
                        <colgroup>
                            <col class="col-month" />
                            <col class="col-currency" />
                            <col class="col-currency" />
                            <col class="col-currency" />
                            <col class="col-orders" />
                            <col class="col-currency" />
                        </colgroup>
                        <thead class="table-light">
                            <tr>
                                <th class="text-white" style="background-color: transparent;">Month</th>
                                <th class="text-end text-white" style="background-color: transparent;">Order Revenue</th>
                                <th class="text-end text-white" style="background-color: transparent;">Subscription Revenue</th>
                                <th class="text-end text-white" style="background-color: transparent;">Total Revenue</th>
                                <th class="text-end text-white" style="background-color: transparent;">Orders</th>
                                <th class="text-end text-white" style="background-color: transparent;">Avg Order Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.FilteredReports)
                            {
                                <tr>
                                    <td class="text-end text-white" style="background-color: transparent;"><strong>@report.MonthName</strong></td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        @if (report.HasOrderRevenue)
                                        {
                                            <span class="text-success">@report.TotalOrderRevenue.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">$0.00</span>
                                        }
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        @if (report.HasSubscriptionRevenue)
                                        {
                                            <span class="text-info">@report.TotalSubscriptionRevenue.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">$0.00</span>
                                        }
                                    </td>
                                    <td class="text-white col-currency" style="background-color: transparent;">
                                        <strong class="text-primary">@report.TotalRevenue.ToString("C")</strong>
                                    </td>
                                    <td class="text-center text-white col-orders" style="background-color: transparent;">
                                        @if (report.HasOrders)
                                        {
                                            <span>@report.TotalOrdersCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-end text-white" style="background-color: transparent;">
                                        @if (report.HasOrders)
                                        {
                                            <span>@report.AverageOrderValue.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th class="text-white text-success"style="background-color: transparent;">Total</th>
                                <th class="text-end text-success" style="background-color: transparent;">@Model.YearlySummary.TotalOrderRevenue.ToString("C")</th>
                                <th class="text-end text-info" style="background-color: transparent;">@Model.YearlySummary.TotalSubscriptionRevenue.ToString("C")</th>
                                <th class="text-end text-primary" style="background-color: transparent;"><strong>@Model.YearlySummary.TotalRevenue.ToString("C")</strong></th>
                                <th class="text-end text-white" style="background-color: transparent;">@Model.YearlySummary.TotalOrders</th>
                                <th class="text-end text-white" style="background-color: transparent;">-</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-graph-up" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3">No Revenue Reports Available</h4>
                <p class="text-muted">
                    @if (Model.IsFiltering)
                    {
                        <span>No reports found for the selected date range. Try adjusting your filters or generate a new report.</span>
                    }
                    else
                    {
                        <span>No reports have been generated yet. Select a month and year above to generate your first report.</span>
                    }
                </p>
            </div>
        </div>
    }
</div>

<style>
    .table tbody tr {
        transition: background-color 0.2s;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .revenue-breakdown-table .revenue-total-row td {
        background: rgba(34, 177, 76, 0.16) !important;
        border-top: 2px solid rgba(34, 177, 76, 0.55);
        font-weight: 700;
    }

    .revenue-breakdown-table .revenue-total-row td strong {
        letter-spacing: 0.2px;
    }

    .revenue-breakdown-table {
        table-layout: fixed;
    }

    .revenue-breakdown-table .col-month {
        width: 140px;
        text-align: center;
    }

    .revenue-breakdown-table .col-orders {
        width: 110px;
        text-align: center;
    }

    .revenue-breakdown-table .col-currency {
        width: 200px;
        text-align: center;
    }

    .revenue-breakdown-table th,
    .revenue-breakdown-table td {
        vertical-align: middle;
        white-space: nowrap;
    }

    @@media (max-width: 1200px) {
        .revenue-breakdown-table {
            table-layout: auto;
        }

        .revenue-breakdown-table th,
        .revenue-breakdown-table td {
            white-space: normal;
        }
    }
    
    .summary-card {
        background-color: #1e293b;
        min-height: 132px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .summary-card-title {
        color: #cbd5e1;
        font-weight: 600;
    }

    .summary-card-meta {
        color: #94a3b8;
        min-height: 1.2rem;
        margin-top: 0.5rem;
        display: block;
    }

    .summary-card h3 {
        line-height: 1.2;
    }

    .summary-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
</style>
