@page
@model MealPrepService.Web.Pages.Order.StaffReviewModel
@{
    ViewData["Title"] = "Order List";
}

<div class="order-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white mb-0">Order List</h2>
    </div>

    <div class="status-tree-wrapper">
        <div class="status-tree-scroll">
            <div class="status-tree">
                <svg class="tree-svg" viewBox="0 0 1200 320" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M120,160 C210,160 210,60 300,60" />
                    <path d="M120,160 C210,160 210,260 300,260" />
                    <path d="M410,60 C500,60 500,160 560,160" />
                    <path d="M410,260 C500,260 500,160 560,160" />
                    <path d="M680,160 C740,160 740,50 810,50" />
                    <path d="M680,160 C740,160 740,270 810,270" />
                    <path d="M920,50 C990,50 990,160 1030,160" />
                    <path d="M920,280 C990,280 990,160 1030,160" />
                </svg>

                <a asp-page="./StaffReview" asp-route-status="pending" asp-route-period="@Model.Period" class="tree-node node-pending @(Model.Status == "pending" ? "active" : string.Empty)">
                    Pending <span class="tab-count">@Model.GetStatusCount("pending")</span>
                </a>
                <a asp-page="./StaffReview" asp-route-status="confirmed" asp-route-period="@Model.Period" class="tree-node node-confirmed @(Model.Status == "confirmed" ? "active" : string.Empty)">
                    Confirmed <span class="tab-count">@Model.GetStatusCount("confirmed")</span>
                </a>
                <a asp-page="./StaffReview" asp-route-status="cancelled" asp-route-period="@Model.Period" class="tree-node node-cancelled @(Model.Status == "cancelled" ? "active" : string.Empty)">
                    Canceled <span class="tab-count">@Model.GetStatusCount("cancelled")</span>
                </a>
                <a asp-page="./StaffReview" asp-route-status="preparing" asp-route-period="@Model.Period" class="tree-node node-preparing @(Model.Status == "preparing" ? "active" : string.Empty)">
                    Preparing <span class="tab-count">@Model.GetStatusCount("preparing")</span>
                </a>
                <a asp-page="./StaffReview" asp-route-status="prepared" asp-route-period="@Model.Period" class="tree-node node-prepared @(Model.Status == "prepared" ? "active" : string.Empty)">
                    Prepared <span class="tab-count">@Model.GetStatusCount("prepared")</span>
                </a>
                <a asp-page="./StaffReview" asp-route-status="preparing_failed" asp-route-period="@Model.Period" class="tree-node node-preparing-failed @(Model.Status == "preparing_failed" ? "active" : string.Empty)">
                    Preparing Failed <span class="tab-count">@Model.GetStatusCount("preparing_failed")</span>
                </a>
                <a asp-page="./StaffReview" asp-route-status="on_scheduled" asp-route-period="@Model.Period" class="tree-node node-scheduled @(Model.Status == "on_scheduled" ? "active" : string.Empty)">
                    On Scheduled <span class="tab-count">@Model.GetStatusCount("on_scheduled")</span>
                </a>
            </div>
        </div>
        <small class="status-tree-caption">Transitions follow the connector flow.</small>
    </div>

    <div class="period-filter mb-3">
        <a asp-page="./StaffReview" asp-route-status="@Model.Status" asp-route-period="all" class="period-btn @(Model.Period == "all" ? "active" : string.Empty)">All</a>
        <a asp-page="./StaffReview" asp-route-status="@Model.Status" asp-route-period="today" class="period-btn @(Model.Period == "today" ? "active" : string.Empty)">Today</a>
        <a asp-page="./StaffReview" asp-route-status="@Model.Status" asp-route-period="this_week" class="period-btn @(Model.Period == "this_week" ? "active" : string.Empty)">This Week</a>
        <a asp-page="./StaffReview" asp-route-status="@Model.Status" asp-route-period="this_month" class="period-btn @(Model.Period == "this_month" ? "active" : string.Empty)">This Month</a>
    </div>

    @if (Model.Orders.Any())
    {
        <div class="table-responsive order-table-wrapper">
            <table class="table table-borderless align-middle order-table">
                <colgroup>
                    <col style="width: 10%" />
                    <col style="width: 15%" />
                    <col style="width: 15%" />
                    <col style="width: 7%" />
                    <col style="width: 8%" />
                    <col style="width: 8%" />
                    <col style="width: 12%" />
                    <col style="width: 25%" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th>Items</th>
                        <th>Payment</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        var tabStatus = Model.NormalizeTabStatus(order.Status);
                        var modalSuffix = order.Id.ToString("N");
                        <tr>
                            <td>
                                <a asp-page="/Order/Details" asp-route-orderId="@order.Id" class="order-code">@order.Id.ToString().Substring(0, 8).ToUpperInvariant()</a>
                            </td>
                            <td>@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy, hh:mm tt")</td>
                            <td>@((order.UpdatedAt ?? order.OrderDate).ToLocalTime().ToString("MMM dd, yyyy, hh:mm tt"))</td>
                            <td>
                                @order.ItemsCount item@(order.ItemsCount > 1 ? "s" : string.Empty)
                            </td>
                            <td>@order.PaymentMethod</td>
                            <td class="order-total">$@order.TotalAmount.ToString("N2")</td>
                            <td>
                                <span class="@Model.GetBadgeClass(order.Status)">@Model.GetDisplayStatus(order.Status)</span>
                            </td>
                            <td class="action-cell">
                                <div class="action-inline">
                                    <button type="button" class="btn btn-action btn-view" data-bs-toggle="modal" data-bs-target="#orderItemsModal-@modalSuffix">View Details</button>
                                    <div id="statusMenuWrap-@modalSuffix" class="status-menu-wrap">
                                        <button type="button"
                                                class="btn btn-action btn-menu status-menu-toggle"
                                                data-target="#statusMenu-@modalSuffix"
                                                aria-controls="statusMenu-@modalSuffix"
                                                aria-expanded="false">
                                            Change Status
                                        </button>
                                        <ul id="statusMenu-@modalSuffix" class="status-dropdown-menu" role="menu" hidden>
                                            @if (tabStatus == "pending")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Confirm" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Confirmed</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="Cancel" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Canceled</button>
                                                    </form>
                                                </li>
                                            }
                                            else if (tabStatus == "confirmed")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="ToPending" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Pending</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="Prepare" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Preparing</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="Cancel" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Canceled</button>
                                                    </form>
                                                </li>
                                            }
                                            else if (tabStatus == "preparing")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Confirm" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Confirmed</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="Cancel" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Canceled</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="PrepareSuccess" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Prepared</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="PrepareFailed" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Preparing Failed</button>
                                                    </form>
                                                </li>
                                            }
                                            else if (tabStatus == "preparing_failed")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="ToPreparing" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Preparing</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="PrepareSuccess" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Prepared</button>
                                                    </form>
                                                </li>
                                            }
                                            else if (tabStatus == "prepared")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="ToPreparing" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Preparing</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="PrepareFailed" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Preparing Failed</button>
                                                    </form>
                                                </li>
                                                @if (order.DeliverySchedule != null)
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item dropdown-item-modal" data-bs-toggle="modal" data-bs-target="#scheduleModal-@modalSuffix">To On Scheduled</button>
                                                    </li>
                                                }
                                            }
                                            else if (tabStatus == "cancelled")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Confirm" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Confirmed</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form method="post" asp-page-handler="ToPending" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Pending</button>
                                                    </form>
                                                </li>
                                            }
                                            else if (tabStatus == "on_scheduled")
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="RestorePrepared" class="dropdown-item-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="statusFilter" value="@Model.Status" />
                                                        <input type="hidden" name="periodFilter" value="@Model.Period" />
                                                        <button type="submit" class="dropdown-item">To Prepared</button>
                                                    </form>
                                                </li>
                                            }
                                            else
                                            {
                                                <li><span class="status-empty">No status actions available</span></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @foreach (var order in Model.Orders)
        {
            var modalSuffix = order.Id.ToString("N");
            var scheduleLocal = (order.DeliverySchedule?.DeliveryTime ?? DateTime.Now.AddHours(2)).ToLocalTime();
            var lunchLocal = DateTime.Now.Date.AddDays(1).AddHours(11).AddMinutes(30);
            var dinnerLocal = DateTime.Now.Date.AddDays(1).AddHours(18);

            <div class="modal fade" id="orderItemsModal-@modalSuffix" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Order Detail - @order.Id.ToString().Substring(0, 8).ToUpperInvariant()</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Customer Name</small>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "N/A" : order.CustomerName)</span>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Phone Number</small>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(order.CustomerContact) ? "N/A" : order.CustomerContact)</span>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted d-block">Delivery Address</small>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(order.DeliveryAddress) ? "N/A" : order.DeliveryAddress)</span>
                                </div>
                            </div>

                            @if (order.OrderDetails.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Recipe</th>
                                                <th class="text-center">Qty</th>
                                                <th class="text-end">Unit Price</th>
                                                <th class="text-end">Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.OrderDetails)
                                            {
                                                var recipeName = item.MenuMeal?.RecipeName ?? "Unknown Recipe";
                                                var subtotal = item.UnitPrice * item.Quantity;
                                                <tr>
                                                    <td>@recipeName</td>
                                                    <td class="text-center">@item.Quantity</td>
                                                    <td class="text-end">$@item.UnitPrice.ToString("N2")</td>
                                                    <td class="text-end fw-semibold">$@subtotal.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <strong class="text-muted">Total Items: @order.ItemsCount</strong>
                                    <strong class="text-muted">Order Total: $@order.TotalAmount.ToString("N2")</strong>
                                </div>
                            }
                            else
                            {
                                <p class="mb-0 text-muted">No items found for this order.</p>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.NormalizeTabStatus(order.Status) == "prepared" && order.DeliverySchedule != null)
            {
                <div class="modal fade" id="scheduleModal-@modalSuffix" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Schedule Delivery - @order.Id.ToString().Substring(0, 8).ToUpperInvariant()</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form method="post" asp-page-handler="Schedule">
                                @Html.AntiForgeryToken()
                                <div class="modal-body">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <input type="hidden" name="deliveryScheduleId" value="@order.DeliverySchedule.Id" />
                                    <input type="hidden" name="statusFilter" value="@Model.Status" />
                                    <input type="hidden" name="periodFilter" value="@Model.Period" />

                                    <label class="form-label fw-semibold" for="deliveryMan-@modalSuffix">Assign delivery man</label>
                                    <select id="deliveryMan-@modalSuffix" name="deliveryManId" class="form-select mb-3" required>
                                        <option value="">Select delivery man</option>
                                        @foreach (var deliveryMan in Model.DeliveryManOptions)
                                        {
                                            <option value="@deliveryMan.Value">@deliveryMan.Text</option>
                                        }
                                    </select>

                                    <div class="schedule-card">
                                        <label class="form-label fw-semibold">Choose delivery time preset</label>
                                        <select class="form-select schedule-option-select mb-3" data-target="#selectedTime-@modalSuffix">
                                            <option value="current" selected>Current planned time</option>
                                            <option value="lunch">Tomorrow Lunch (11:30 AM)</option>
                                            <option value="dinner">Tomorrow Dinner (06:00 PM)</option>
                                            <option value="custom">Custom date & time</option>
                                        </select>

                                        <label class="form-label fw-semibold" for="selectedTime-@modalSuffix">Selected delivery datetime</label>
                                        <input id="selectedTime-@modalSuffix"
                                               name="selectedDeliveryTime"
                                               type="datetime-local"
                                               class="form-control schedule-time-input"
                                               value="@scheduleLocal.ToString("yyyy-MM-ddTHH:mm")"
                                               data-current="@scheduleLocal.ToString("yyyy-MM-ddTHH:mm")"
                                               data-lunch="@lunchLocal.ToString("yyyy-MM-ddTHH:mm")"
                                               data-dinner="@dinnerLocal.ToString("yyyy-MM-ddTHH:mm")"
                                               required />
                                        <small class="text-muted d-block mt-2">You can pick a preset and still adjust the exact datetime manually.</small>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-success">Confirm Schedule</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="empty-state">
            <div class="card-body text-center py-5">
                <i class="bi bi-check2-circle" style="font-size: 3rem; color: #9ca3af;"></i>
                <h4 class="mt-3">No orders found</h4>
                <p class="text-muted mb-0">There are no orders for this status and period.</p>
            </div>
        </div>
    }
</div>

<style>
    .order-list-page {
        padding: 1.5rem 0;
    }

    .status-tree-wrapper {
        border-bottom: 1px solid #d1d5db;
        margin-bottom: 1rem;
        padding-bottom: 0.9rem;
    }

    .status-tree-scroll {
        overflow-x: auto;
    }

    .status-tree {
        position: relative;
        width: 100%;
        min-width: 1020px;
        height: 300px;
    }

    .tree-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
    }

    .tree-svg path {
        fill: none;
        stroke: #2dde69;
        stroke-width: 7;
        stroke-linecap: round;
        stroke-linejoin: round;
        shape-rendering: geometricPrecision;
        filter: drop-shadow(0 0 2px rgba(45, 222, 105, 0.55));
    }

    .order-list-page .tree-node {
        position: absolute;
        z-index: 2;
        transform: translate(-50%, -50%);
        font-weight: 700;
        color: #1f2937 !important;
        text-decoration: none;
        padding: 0.8rem 1.2rem;
        border-radius: 0.65rem;
        background: #e5e7eb;
        border: 2px solid #101010;
        min-width: 12rem;
        text-align: center;
        transition: all 0.2s ease;
        box-shadow: 0 2px 0 rgba(16, 16, 16, 0.35);
    }

    .node-pending {
        left: 8%;
        top: 53%;
    }

    .node-confirmed {
        left: 29%;
        top: 21%;
    }

    .node-cancelled {
        left: 29%;
        top: 84%;
    }

    .node-preparing {
        left: 50%;
        top: 53%;
    }

    .node-prepared {
        left: 72%;
        top: 17%;
    }

    .node-preparing-failed {
        left: 72%;
        top: 87%;
    }

    .node-scheduled {
        left: 92%;
        top: 53%;
    }

    .order-list-page .tree-node.active,
    .order-list-page .tree-node:hover {
        color: #ffffff !important;
        background: #2cad46;
        border-color: #1f8f36;
    }

    .status-tree-caption {
        display: block;
        color: #6b7280;
        margin-top: 0.45rem;
    }

    .order-list-page .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.4rem;
        height: 1.4rem;
        margin-left: 0.35rem;
        border-radius: 999px;
        background: #f9fafb;
        color: #111827 !important;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .period-filter {
        display: flex;
        gap: 0.5rem;
    }

    .order-list-page .period-btn {
        text-decoration: none;
        border: 1px solid #d1d5db;
