@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectors = document.querySelectorAll('.schedule-option-select');
            selectors.forEach(function (select) {
                select.addEventListener('change', function () {
                    const targetSelector = select.getAttribute('data-target');
                    if (!targetSelector) {
                        return;
                    }

                    const dateInput = document.querySelector(targetSelector);
                    if (!dateInput) {
                        return;
                    }

                    const selected = select.value;
                    if (selected === 'current') {
                        dateInput.value = dateInput.getAttribute('data-current') || dateInput.value;
                    } else if (selected === 'lunch') {
                        dateInput.value = dateInput.getAttribute('data-lunch') || dateInput.value;
                    } else if (selected === 'dinner') {
                        dateInput.value = dateInput.getAttribute('data-dinner') || dateInput.value;
                    }
                });
            });

            let activeStatusMenu = null;

            function positionPortalStatusMenu(menu, toggle) {
                const toggleRect = toggle.getBoundingClientRect();
                const menuRect = menu.getBoundingClientRect();
                const viewportPadding = 8;
                const gap = 8;

                let top = window.scrollY + toggleRect.bottom + gap;
                const viewportBottom = window.scrollY + window.innerHeight;
                if (top + menuRect.height > viewportBottom - viewportPadding) {
                    top = window.scrollY + toggleRect.top - menuRect.height - gap;
                }
                top = Math.max(window.scrollY + viewportPadding, top);

                let left = window.scrollX + toggleRect.right - menuRect.width;
                const viewportRight = window.scrollX + window.innerWidth;
                if (left + menuRect.width > viewportRight - viewportPadding) {
                    left = viewportRight - menuRect.width - viewportPadding;
                }
                left = Math.max(window.scrollX + viewportPadding, left);

                menu.style.top = top + 'px';
                menu.style.left = left + 'px';
            }

            function closeAllStatusMenus() {
                if (activeStatusMenu && activeStatusMenu.repositionHandler) {
                    window.removeEventListener('resize', activeStatusMenu.repositionHandler);
                    window.removeEventListener('scroll', activeStatusMenu.repositionHandler, true);
                }

                const menus = document.querySelectorAll('.status-dropdown-menu');
                const toggles = document.querySelectorAll('.status-menu-toggle');

                menus.forEach(function (menu) {
                    if (menu.dataset.originParent) {
                        const parent = document.getElementById(menu.dataset.originParent);
                        if (parent) {
                            parent.appendChild(menu);
                        }
                        delete menu.dataset.originParent;
                    }

                    menu.classList.remove('portal-open');
                    menu.style.top = '';
                    menu.style.left = '';
                    menu.setAttribute('hidden', 'hidden');
                });

                toggles.forEach(function (toggle) {
                    toggle.setAttribute('aria-expanded', 'false');
                });

                activeStatusMenu = null;
            }

            const statusToggles = document.querySelectorAll('.status-menu-toggle');
            statusToggles.forEach(function (toggle) {
                toggle.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();

                    const targetSelector = toggle.getAttribute('data-target');
                    if (!targetSelector) {
                        return;
                    }

                    const menu = document.querySelector(targetSelector);
                    if (!menu) {
                        return;
                    }

                    const shouldOpen = menu.hasAttribute('hidden');
                    closeAllStatusMenus();

                    if (shouldOpen) {
                        const owner = menu.closest('.status-menu-wrap');
                        if (owner && owner.id) {
                            menu.dataset.originParent = owner.id;
                        }

                        document.body.appendChild(menu);
                        menu.classList.add('portal-open');
                        menu.removeAttribute('hidden');
                        toggle.setAttribute('aria-expanded', 'true');

                        const repositionHandler = function () {
                            positionPortalStatusMenu(menu, toggle);
                        };

                        positionPortalStatusMenu(menu, toggle);
                        window.addEventListener('resize', repositionHandler);
                        window.addEventListener('scroll', repositionHandler, true);

                        activeStatusMenu = {
                            menu: menu,
                            toggle: toggle,
                            repositionHandler: repositionHandler
                        };
                    }
                });
            });

            document.addEventListener('click', function (event) {
                const clickInsideMenu = event.target.closest('.status-menu-wrap');
                if (!clickInsideMenu) {
                    closeAllStatusMenus();
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllStatusMenus();
                }
            });

            const statusMenuItems = document.querySelectorAll('.status-dropdown-menu .dropdown-item');
            statusMenuItems.forEach(function (item) {
                item.addEventListener('click', function () {
                    closeAllStatusMenus();
                });
            });
        });
    </script>
}
