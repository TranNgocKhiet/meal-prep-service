@page "{id:guid}"
@model MealPrepService.Web.Pages.Order.DetailsModel
@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0">Order Details</h4>
                    <small class="text-muted">Order #@Model.Id.ToString().Substring(0, 8)</small>
                </div>
                <div>
                    @if (Model.Status.Equals("pending", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                    else if (Model.Status.Equals("awaiting_online_payment", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-info">Awaiting VNPay</span>
                    }
                    else if (Model.Status.Equals("pending_confirmation", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-warning text-dark">Pending Confirmation</span>
                    }
                    else if (Model.Status.Equals("confirmed", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (Model.Status.Equals("delivering", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-primary">Delivering</span>
                    }
                    else if (Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success">Customer Received</span>
                    }
                    else if (Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-danger">Customer Reject</span>
                    }
                    else if (Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-dark">Failed</span>
                    }
                    else if (Model.Status.Equals("payment_failed", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-danger">Payment Failed</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.Status</span>
                    }
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title">Order Information</h6>
                            <p class="mb-1"><strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                            <p class="mb-1"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                            <p class="mb-0"><strong>Status:</strong> @Model.Status</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title">Order Total</h6>
                            <h3 class="text-primary">$@Model.TotalAmount.ToString("F2")</h3>
                            <p class="mb-0 text-muted">@Model.OrderDetails_Items.Sum(d => d.Quantity) items</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Status.Equals("pending_confirmation", StringComparison.OrdinalIgnoreCase) && 
                 Model.PaymentMethod.Equals("COD", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    <strong>Cash on Delivery:</strong> Payment will be confirmed by the delivery person upon delivery.
                </div>
            }

            @if (Model.Status.Equals("payment_failed", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> 
                    <strong>Payment Failed:</strong> Your payment could not be processed. Please try again.
                    <form asp-page="Retry" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-warning ms-2">
                            <i class="bi bi-arrow-clockwise"></i> Retry Payment
                        </button>
                    </form>
                </div>
            }

            <h5 class="mb-3">Order Items</h5>
            <div class="table-responsive mb-4">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails_Items)
                        {
                            <tr>
                                <td>
                                    <strong>@detail.RecipeName</strong>
                                    @if (detail.Recipe != null)
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @detail.Recipe.TotalCalories.ToString("F0") kcal | 
                                            P: @detail.Recipe.ProteinG.ToString("F1")g | 
                                            F: @detail.Recipe.FatG.ToString("F1")g | 
                                            C: @detail.Recipe.CarbsG.ToString("F1")g
                                        </small>
                                    }
                                </td>
                                <td>@detail.Quantity</td>
                                <td>$@detail.UnitPrice.ToString("F2")</td>
                                <td>$@((detail.Quantity * detail.UnitPrice).ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th>$@Model.TotalAmount.ToString("F2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (Model.DeliveryInfo != null)
            {
                <h5 class="mb-3">Delivery Information</h5>
                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Delivery Time:</strong></p>
                                <p>@Model.DeliveryInfo.DeliveryTime.ToString("MMM dd, yyyy hh:mm tt")</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Delivery Address:</strong></p>
                                <p>@Model.DeliveryInfo.Address</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.DeliveryInfo.DriverContact))
                        {
                            <p class="mb-0"><strong>Driver Contact:</strong> @Model.DeliveryInfo.DriverContact</p>
                        }
                    </div>
                </div>

                var deliveryReportText = Model.Status.ToLowerInvariant() switch
                {
                    "pending_confirmation" => "Your order is waiting for staff confirmation before dispatch.",
                    "confirmed" => "Your delivery is confirmed and waiting for a driver assignment.",
                    "delivering" => "Your order is currently on the way.",
                    "customer_received" => "Customer delivery report: received successfully.",
                    "customer_reject" => "Customer delivery report: rejected at handoff.",
                    "failed" => "Customer delivery report: delivery attempt failed.",
                    "cancelled" => "Order was cancelled before delivery completion.",
                    _ => "Delivery report is being updated."
                };

                var deliveryReportClass = Model.Status.ToLowerInvariant() switch
                {
                    "customer_received" => "alert alert-success",
                    "customer_reject" => "alert alert-danger",
                    "failed" => "alert alert-dark",
                    "delivering" => "alert alert-primary",
                    "confirmed" => "alert alert-info",
                    "pending_confirmation" => "alert alert-warning",
                    _ => "alert alert-secondary"
                };

                <h5 class="mb-3">Customer Delivery Report</h5>
                <div class="@deliveryReportClass mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Status:</strong> @Model.Status
                        </div>
                        @if (Model.DeliveryInfo.DeliveryTime != default)
                        {
                            <small>Scheduled: @Model.DeliveryInfo.DeliveryTime.ToString("MMM dd, yyyy hh:mm tt")</small>
                        }
                    </div>
                    <div class="mt-2">@deliveryReportText</div>
                </div>

                var isConfirmedOrLater = Model.Status.Equals("confirmed", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("delivering", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase);

                var isDeliveringOrLater = Model.Status.Equals("delivering", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase);

                var isFinal = Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("cancelled", StringComparison.OrdinalIgnoreCase);

                <h5 class="mb-3">Delivery Tracking</h5>
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge @(Model.Status.Equals("pending_confirmation", StringComparison.OrdinalIgnoreCase) ? "bg-primary" : "bg-secondary")">1. Pending Confirmation</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge @(isConfirmedOrLater ? "bg-primary" : "bg-secondary")">2. Confirmed</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge @(isDeliveringOrLater ? "bg-primary" : "bg-secondary")">3. Delivering</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge @(isFinal ? "bg-primary" : "bg-secondary")">4. Completed</span>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between">
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>
    </div>
</div>
