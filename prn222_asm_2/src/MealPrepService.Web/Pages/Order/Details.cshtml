@page "{id:guid}"
@model MealPrepService.Web.Pages.Order.DetailsModel
@{
    ViewData["Title"] = "Order Details";

    var normalizedStatus = (Model.Status ?? string.Empty).ToLowerInvariant();
    var statusDisplay = normalizedStatus switch
    {
        "pending" => "Pending",
        "awaiting_online_payment" => "AwaitingOnlinePayment",
        "pending_confirmation" => "PendingConfirmation",
        "confirmed" => "Confirmed",
        "preparing" => "Preparing",
        "preparing_failed" => "PreparingFailed",
        "prepared" => "Prepared",
        "delivering" => "Delivering",
        "customer_received" => "CustomerReceived",
        "customer_reject" => "CustomerReject",
        "failed" => "DeliveryFail",
        "payment_failed" => "PaymentFail",
        "cancelled" => "Cancelled",
        _ => string.IsNullOrWhiteSpace(Model.Status) ? "Unknown" : Model.Status
    };

    var statusClass = normalizedStatus switch
    {
        "pending" or "preparing" => "status-warning",
        "confirmed" or "prepared" or "customer_received" or "delivered" => "status-success",
        "cancelled" or "preparing_failed" or "failed" or "payment_failed" or "customer_reject" => "status-danger",
        _ => "status-info"
    };

    var statusIcon = normalizedStatus switch
    {
        "pending" => "bi-hourglass-split",
        "awaiting_online_payment" => "bi-credit-card-2-front",
        "pending_confirmation" => "bi-clock-history",
        "confirmed" => "bi-patch-check",
        "delivering" => "bi-truck",
        "customer_received" => "bi-check2-circle",
        "customer_reject" => "bi-x-octagon",
        "failed" => "bi-exclamation-octagon",
        "payment_failed" => "bi-shield-x",
        "cancelled" => "bi-slash-circle",
        _ => "bi-question-circle"
    };
}

<style>
    .order-detail-shell .order-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 999px;
        padding: 0.42rem 0.9rem;
        font-weight: 700;
        font-size: 0.85rem;
        border: 1px solid transparent;
        letter-spacing: 0.01em;
    }

    .order-detail-shell .order-status-pill i,
    .order-detail-shell .order-status-pill span {
        color: inherit !important;
    }

    .order-detail-shell .order-status-pill i {
        font-size: 0.9rem;
    }

    .order-detail-shell .status-warning { background: #fff1c4 !important; color: #6b4a00 !important; border-color: #f2cf69 !important; }
    .order-detail-shell .status-success { background: #d4f7de !important; color: #0f5e2f !important; border-color: #8dd8a6 !important; }
    .order-detail-shell .status-danger { background: #ffd9dd !important; color: #8b1d2a !important; border-color: #f0a1aa !important; }
    .order-detail-shell .status-info { background: #dce8ff !important; color: #1b3f83 !important; border-color: #a9c0ff !important; }

    .order-detail-shell .order-summary-card {
        height: 100%;
        border: 1px solid #d9e0ea;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
    }

    .order-detail-shell .order-summary-title {
        color: #4b5563;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.74rem;
        margin-bottom: 0.65rem;
    }

    .order-detail-shell .order-summary-value {
        font-size: 1.95rem;
        font-weight: 700;
        line-height: 1.15;
        color: #0ea35a;
        margin-bottom: 0.35rem;
    }

    .order-detail-shell .order-info-grid p {
        margin-bottom: 0.5rem;
    }

    .order-detail-shell .order-info-grid p:last-child {
        margin-bottom: 0;
    }

    .order-detail-shell .status-report {
        border-width: 1px;
        border-style: solid;
    }

    .order-detail-shell .status-report-warning {
        background: #fff1c4;
        color: #6b4a00;
        border-color: #f2cf69;
    }

    .order-detail-shell .status-report-success {
        background: #d4f7de;
        color: #0f5e2f;
        border-color: #8dd8a6;
    }

    .order-detail-shell .status-report-danger {
        background: #ffd9dd;
        color: #8b1d2a;
        border-color: #f0a1aa;
    }

    .order-detail-shell .status-report-info {
        background: #dce8ff;
        color: #1b3f83;
        border-color: #a9c0ff;
    }
</style>

<div class="container mt-4 order-detail-shell">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0">Order Details</h4>
                    <small class="text-muted">Order #@Model.Id.ToString().Substring(0, 8)</small>
                </div>
                <div>
                    <span class="order-status-pill @statusClass" title="Order Status: @statusDisplay">
                        <i class="bi @statusIcon"></i>
                        <span>@statusDisplay</span>
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-dismissible fade show" role="alert" style="background-color: white; color: black; border: 2px solid black;">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-light order-summary-card">
                        <div class="card-body">
                            <p class="order-summary-title">Order Information</p>
                            <div class="order-info-grid">
                                <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</p>
                                <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                                <p>
                                    <strong>Status:</strong>
                                    <span class="order-status-pill @statusClass ms-1">
                                        <i class="bi @statusIcon"></i>
                                        <span>@statusDisplay</span>
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-light order-summary-card">
                        <div class="card-body">
                            <p class="order-summary-title">Order Total</p>
                            <p class="order-summary-value">$@Model.TotalAmount.ToString("F2")</p>
                            <p class="mb-0 text-muted">@Model.OrderDetails_Items.Sum(d => d.Quantity) items</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-light mb-4">
                <div class="card-body">
                    <h6 class="card-title">Customer Information</h6>
                    <div class="row">
                        <div class="col-md-4">
                            <p class="mb-1"><strong>Name:</strong></p>
                            <p>@(string.IsNullOrWhiteSpace(Model.OrderDetails.CustomerName) ? "N/A" : Model.OrderDetails.CustomerName)</p>
                        </div>
                        <div class="col-md-4">
                            <p class="mb-1"><strong>Phone Number:</strong></p>
                            <p>@(string.IsNullOrWhiteSpace(Model.OrderDetails.CustomerContact) ? "N/A" : Model.OrderDetails.CustomerContact)</p>
                        </div>
                        <div class="col-md-4">
                            <p class="mb-1"><strong>Address:</strong></p>
                            <p>@(string.IsNullOrWhiteSpace(Model.OrderDetails.DeliveryAddress) ? "N/A" : Model.OrderDetails.DeliveryAddress)</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Status.Equals("pending_confirmation", StringComparison.OrdinalIgnoreCase) && 
                 Model.PaymentMethod.Equals("COD", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    <strong>Cash on Delivery:</strong> Payment will be confirmed by the delivery person upon delivery.
                </div>
            }

            @if (Model.Status.Equals("payment_failed", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> 
                    <strong>Payment Failed:</strong> Your payment could not be processed. Please try again.
                    <form asp-page="Retry" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-warning ms-2">
                            <i class="bi bi-arrow-clockwise"></i> Retry Payment
                        </button>
                    </form>
                </div>
            }

            <h5 class="mb-3">Order Items</h5>
            <div class="table-responsive mb-4">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails_Items)
                        {
                            <tr>
                                <td>
                                    <strong>@detail.RecipeName</strong>
                                    @if (detail.Recipe != null)
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @detail.Recipe.TotalCalories.ToString("F0") kcal | 
                                            P: @detail.Recipe.ProteinG.ToString("F1")g | 
                                            F: @detail.Recipe.FatG.ToString("F1")g | 
                                            C: @detail.Recipe.CarbsG.ToString("F1")g
                                        </small>
                                    }
                                </td>
                                <td>@detail.Quantity</td>
                                <td>$@detail.UnitPrice.ToString("F2")</td>
                                <td>$@((detail.Quantity * detail.UnitPrice).ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th>$@Model.TotalAmount.ToString("F2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (Model.DeliveryInfo != null)
            {
                <h5 class="mb-3">Delivery Information</h5>
                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Delivery Time:</strong></p>
                                <p>@Model.DeliveryInfo.DeliveryTime.ToString("MMM dd, yyyy hh:mm tt")</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Delivery Address:</strong></p>
                                <p>@Model.DeliveryInfo.Address</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.DeliveryInfo.DriverContact))
                        {
                            <p class="mb-0"><strong>Driver Contact:</strong> @Model.DeliveryInfo.DriverContact</p>
                        }
                    </div>
                </div>

                var deliveryReportText = Model.Status.ToLowerInvariant() switch
                {
                    "pending_confirmation" => "Your order is waiting for staff confirmation before dispatch.",
                    "confirmed" => "Your delivery is confirmed and waiting for a driver assignment.",
                    "delivering" => "Your order is currently on the way.",
                    "customer_received" => "Customer delivery report: received successfully.",
                    "customer_reject" => "Customer delivery report: rejected at handoff.",
                    "failed" => "Customer delivery report: delivery attempt failed.",
                    "cancelled" => "Order was cancelled before delivery completion.",
                    _ => "Delivery report is being updated."
                };

                var deliveryReportClass = Model.Status.ToLowerInvariant() switch
                {
                    "pending" or "preparing" => "alert status-report status-report-warning",
                    "confirmed" or "prepared" or "customer_received" or "delivered" => "alert status-report status-report-success",
                    "cancelled" or "preparing_failed" or "failed" or "payment_failed" or "customer_reject" => "alert status-report status-report-danger",
                    _ => "alert status-report status-report-info"
                };

                <h5 class="mb-3">Customer Delivery Report</h5>
                <div class="@deliveryReportClass mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Status:</strong>
                            <span class="order-status-pill @statusClass ms-1">
                                <i class="bi @statusIcon"></i>
                                <span>@statusDisplay</span>
                            </span>
                        </div>
                        @if (Model.DeliveryInfo.DeliveryTime != default)
                        {
                            <small>Scheduled: @Model.DeliveryInfo.DeliveryTime.ToString("MMM dd, yyyy hh:mm tt")</small>
                        }
                    </div>
                    <div class="mt-2">@deliveryReportText</div>
                </div>

                var isConfirmedOrLater = Model.Status.Equals("confirmed", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("delivering", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase);

                var isDeliveringOrLater = Model.Status.Equals("delivering", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase);

                var isFinal = Model.Status.Equals("customer_received", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("customer_reject", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("failed", StringComparison.OrdinalIgnoreCase)
                    || Model.Status.Equals("cancelled", StringComparison.OrdinalIgnoreCase);

                <h5 class="mb-3">Delivery Tracking</h5>
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="badge @(Model.Status.Equals("pending_confirmation", StringComparison.OrdinalIgnoreCase) ? "bg-primary" : "bg-secondary")">1. Pending Confirmation</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge @(isConfirmedOrLater ? "bg-primary" : "bg-secondary")">2. Confirmed</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge @(isDeliveringOrLater ? "bg-primary" : "bg-secondary")">3. Delivering</span>
                            <i class="bi bi-arrow-right text-muted"></i>
                            <span class="badge @(isFinal ? "bg-primary" : "bg-secondary")">4. Completed</span>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between">
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Orders
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.__orderPageOrderId = '@Model.Id'.toLowerCase();
    </script>
}
